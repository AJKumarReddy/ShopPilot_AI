# Copy to .env at the repository root. Restart local services or recreate containers after edits.
# Leave DATABASE_URL empty to derive it from POSTGRES_*; set it for an external database.
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=shoppilot
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=shoppilot
AI_MODE=demo
DATASET_MODE=demo
AUTH_MODE=demo
DEMO_AUTH_TOKEN=local-demo-token-change-for-shared-environments
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Routes chat, tool calls, and JSON responses to available free models.
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_REASONING_MODEL=openrouter/free
# Embeddings are billed separately; changing this model requires re-indexing.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Keep empty or use only free model IDs to avoid paid chat fallbacks.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=ShopPilot AI
OPENROUTER_TIMEOUT=30
OPENROUTER_RETRIES=2
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
CORS_ORIGINS=http://localhost:3000
CHECKOUT_TTL_SECONDS=600
TAX_RATE=0.0825
RATE_LIMIT_PER_MINUTE=90
PAYMENT_MODE=approved
# Optional frontend proxy override. Blank uses localhost locally and backend in Docker.
# Frontend production builds must be rebuilt after changing BACKEND_URL.
BACKEND_URL=
# STT and TTS use browser speech APIs; no server-side speech models or keys.
